// THB Phone Manager — Prisma schema
// Production (Vercel) dùng PostgreSQL — SQLite không dùng được trên serverless vì
// filesystem không ghi được/không persist giữa các lần gọi function.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER // Cấp 1 — người quản lý lớp
  TEACHER // Cấp 2 — giáo viên chủ nhiệm
  ADMIN // Cấp 3 — quản trị viên cấp cao
}

enum AssignmentRole {
  MANAGER
  TEACHER
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  CHECK_IN // cất điện thoại
  CHECK_OUT // trả điện thoại
}

enum ReportScope {
  CLASS
  SCHOOL
}

enum ReportStatus {
  DRAFT
  PREVIEW
  APPROVED
  SENT
  POSTPONED
  CANCELLED
  FAILED
}

enum SendStatus {
  SUCCESS
  FAILED
}

enum ImportBatchStatus {
  PENDING // đã xem trước, chờ xác nhận
  PROCESSING // đang ghi — chặn commit trùng khi bấm xác nhận nhiều lần
  COMMITTED
  FAILED
}

enum DayStatusCode {
  NOT_RECORDED // Chưa ghi nhận cất
  CHECKED_IN // Đã cất
  CHECKED_OUT // Đã trả
  ABSENT // Vắng mặt (đã xác minh)
  EXEMPTED // Được miễn / có lý do hợp lệ
  NEEDS_VERIFICATION // Cần xác minh
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         Role
  isLocked     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  assignments        ClassAssignment[]
  sessions           Session[]
  performedTxns      PhoneTransaction[]    @relation("PerformedByUser")
  comments           TeacherComment[]
  approvedReports    WeeklyReport[]        @relation("ApprovedByUser")
  auditLogs          AuditLog[]            @relation("ActorUser")
  importBatches      ImportBatch[]         @relation("ImportUploadedByUser")
  dayStatusAdjustments DayStatusAdjustment[] @relation("AdjustedByUser")

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  @@index([userId])
}

model Class {
  id        String   @id @default(cuid())
  code      String   @unique // ví dụ "12A1"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments  ClassAssignment[]
  students     Student[]
  transactions PhoneTransaction[]
  comments     TeacherComment[]
  reports      WeeklyReport[]
  recipientCfg ReportScheduleConfig[]
  importBatches ImportBatch[]
  dayStatusAdjustments DayStatusAdjustment[]
}

model ClassAssignment {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  role      AssignmentRole
  createdAt DateTime       @default(now())

  @@unique([userId, classId, role])
  @@index([classId])
  @@index([userId])
}

model Student {
  id          String        @id @default(cuid())
  studentCode String        @unique
  fullName    String
  classId     String
  class       Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions PhoneTransaction[]
  comments     TeacherComment[]
  dayStatusAdjustments DayStatusAdjustment[]

  @@index([classId])
}

model PhoneTransaction {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId         String
  class           Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  type            TransactionType
  performedById   String
  performedBy     User            @relation("PerformedByUser", fields: [performedById], references: [id], onDelete: Restrict)
  note            String?
  createdAt       DateTime        @default(now())

  // Bất biến: không có trường updatedAt / không có API update-delete cho bảng này.

  @@index([classId, createdAt])
  @@index([studentId, createdAt])
}

model TeacherComment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
}

model WeeklyReport {
  id                 String       @id @default(cuid())
  scope              ReportScope
  classId            String? // null khi scope = SCHOOL
  class              Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekStart          DateTime
  weekEnd            DateTime
  status             ReportStatus @default(DRAFT)
  contentJson        String // JSON string: số liệu tổng hợp + phần nội dung được phép chỉnh sửa
  contentVersion      Int          @default(1)
  dataIssues         String? // JSON string: cảnh báo thiếu dữ liệu / giao dịch chưa xác minh
  approvedById       String?
  approvedBy         User?        @relation("ApprovedByUser", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  recipientsSnapshot String? // JSON string danh sách email lúc gửi
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sendLogs ReportSendLog[]

  @@unique([scope, classId, weekStart])
  @@index([weekStart])
}

model ReportSendLog {
  id        String       @id @default(cuid())
  reportId  String
  report    WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipient String
  status    SendStatus
  adapter   String // "console-preview" | "smtp"
  error     String?
  createdAt DateTime     @default(now())

  @@index([reportId])
}

model ReportScheduleConfig {
  id          String   @id @default(cuid())
  classId     String? // null = cấu hình cho báo cáo toàn trường
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  cronExpr    String // ví dụ "0 17 * * FRI" — chạy 17h thứ 6 hằng tuần
  recipients  String // JSON string: danh sách email
  isActive    Boolean  @default(true)
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([classId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("ActorUser", fields: [actorId], references: [id], onDelete: Restrict)
  action     String // ví dụ "USER_LOCK", "STUDENT_ARCHIVE", "REPORT_APPROVE_SEND"
  targetType String // "User" | "Student" | "Class" | "WeeklyReport" | ...
  targetId   String
  metadata   String? // JSON string chi tiết (không chứa mật khẩu/token)
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/**
 * Trạng thái tạm giữa bước "xem trước" và "xác nhận nhập" khi admin nhập danh sách học
 * sinh từ file (.xlsx/.xls/.csv). rowsJson lưu các dòng đã chuẩn hoá từ lúc xem trước —
 * khi xác nhận, hệ thống phân loại LẠI (NEW/UPDATE/CLASS_CONFLICT/...) theo dữ liệu
 * hiện tại trong DB (không tin kết quả xem trước đã cũ). Chuyển PENDING -> PROCESSING
 * bằng update có điều kiện để 1 batch chỉ được xác nhận đúng 1 lần dù bấm nhiều lần.
 */
model ImportBatch {
  id            String            @id @default(cuid())
  classId       String
  class         Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User              @relation("ImportUploadedByUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName      String
  status        ImportBatchStatus @default(PENDING)
  rowsJson      String // JSON: [{ rowNumber, studentCode, fullName }]
  totalRows     Int
  validRows     Int
  createdCount  Int?
  updatedCount  Int?
  conflictCount Int?
  duplicateCount Int?
  invalidCount  Int?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  committedAt   DateTime?

  @@index([classId])
  @@index([uploadedById])
}

/**
 * Điều chỉnh trạng thái cất/trả của 1 học sinh trong 1 ngày cụ thể, do Cấp 3 thực hiện
 * qua quy trình kiểm soát (bắt buộc lý do). CHỈ GHI THÊM (append-only) — không bao giờ
 * update/xoá bản ghi cũ, nên lịch sử gốc + mọi lần điều chỉnh trước luôn còn nguyên.
 * Trạng thái "hiệu lực" của 1 (student, date) = bản ghi có createdAt mới nhất, nếu có;
 * không có thì suy ra từ PhoneTransaction như bình thường (xem src/lib/overview.ts).
 */
model DayStatusAdjustment {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  date           DateTime // mốc 00:00 Asia/Ho_Chi_Minh của ngày được điều chỉnh
  previousStatus String // snapshot trạng thái hiệu lực trước khi điều chỉnh (DayStatusCode dạng string)
  newStatus      DayStatusCode
  reason         String
  note           String?
  adjustedById   String
  adjustedBy     User          @relation("AdjustedByUser", fields: [adjustedById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())

  @@index([studentId, date])
  @@index([classId, date])
}
