# Sao chép file này thành .env rồi điền giá trị thật — KHÔNG commit .env

# Database — PostgreSQL (SQLite không dùng được khi deploy lên Vercel).
# Lấy chuỗi kết nối từ Neon/Supabase/Vercel Postgres, ví dụ:
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session cookie — chuỗi ngẫu nhiên dùng để ký/kiểm tra token, đổi khi deploy thật
SESSION_SECRET="change-me-to-a-long-random-string"

# Mật khẩu tài khoản admin khởi tạo khi chạy `npm run seed` — KHÔNG đặt giá trị dễ đoán,
# bắt buộc đổi mật khẩu ngay sau lần đăng nhập đầu tiên trên môi trường thật.
SEED_ADMIN_PASSWORD="change-me-before-seeding"

# (Tuỳ chọn) SMTP thật để gửi báo cáo cuối tuần — nếu bỏ trống, hệ thống dùng
# chế độ xem trước (preview) và không tuyên bố đã gửi email thật.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
